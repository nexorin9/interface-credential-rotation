<?xml version="1.0" encoding="UTF-8"?>
<!--
  接口账号密钥轮换系统 · 构建配置

  栈：Java 17 + Maven + JavaFX 21（桌面常驻小工具）
  入口：javafx-maven-plugin 的 run 目标（桌面窗口 + AWT 托盘）；CLI 走 cli 子命令分支

  说明：
  * JavaFX 以 Maven 中央仓库的模块化构件形式引入；带平台分类符的 jar 携带 module-info，
    故运行时以模块路径（module-path）加 add-modules javafx.controls 装配。
  * 依赖统一复制到 target/dependency，供 javafx-maven-plugin 与 surefire 的模块路径共用，
    避免两处各写一套路径。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.med</groupId>
  <artifactId>interface-credential-rotation</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>interface-credential-rotation</name>
  <description>接口账号密钥轮换系统 —— 对外接口凭据到期预警、失效归因与换证闭环</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>17</maven.compiler.release>

    <javafx.version>21.0.2</javafx.version>
    <jackson.version>2.17.2</jackson.version>
    <sqlite.version>3.46.1.3</sqlite.version>
    <slf4j.version>1.7.36</slf4j.version>
    <junit.version>5.10.2</junit.version>

    <main.class>com.med.icr.Main</main.class>
    <module.path>${project.build.directory}/dependency</module.path>
  </properties>

  <dependencies>
    <!-- 桌面窗口与控件（模块 javafx.controls） -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <!-- 接口报文解析（失败事件流 / 台账 / 处置单 / 自检结论） -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- 本地状态库：凭据台账缓存 / 事件归档 / since 游标 / 审计 -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite.version}</version>
    </dependency>

    <!--
      sqlite-jdbc 把 slf4j-api 标为 optional，但它的模块描述符里 requires org.slf4j，
      且打开数据库时确实会调用 slf4j —— 因此这里显式补上，否则模块路径解析与运行时都会缺件。
    -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

    <!-- 测试 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>interface-credential-rotation</finalName>

    <plugins>
      <!-- 把全部运行期依赖铺到 target/dependency，作为 module-path 的唯一来源 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>copy-runtime-deps</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${module.path}</outputDirectory>
              <includeScope>runtime</includeScope>
              <overWriteIfNewer>true</overWriteIfNewer>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>

      <!-- 桌面入口：以模块路径方式启动 JavaFX -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>${main.class}</mainClass>
          <options>
            <option>--module-path</option>
            <option>${module.path}</option>
            <option>--add-modules</option>
            <option>javafx.controls</option>
          </options>
        </configuration>
      </plugin>

      <!-- 测试：显式 module-path，JavaFX 相关用例可直接建 Scene -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <argLine>--module-path ${module.path} --add-modules javafx.controls,jdk.httpserver</argLine>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>

      <!-- 打包：jar 清单写入主类，便于院内拷贝即用 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${main.class}</mainClass>
              <!-- CLI 以 java -jar 直接启动时，从同目录 target/dependency 解析运行期依赖；
                   桌面端仍由 javafx-maven-plugin / jpackage 以模块路径启动。 -->
              <addClasspath>true</addClasspath>
              <classpathPrefix>dependency/</classpathPrefix>
              <useUniqueVersions>false</useUniqueVersions>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
