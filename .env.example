# ---------------------------------------------------------------------------
# 接口账号密钥轮换系统 · 环境变量样例
#
# 用法：复制本文件为 .env，按院内实际地址与令牌填写后启动。
#   cp .env.example .env
#
# 安全约定：
#   * .env 已被 .gitignore 排除，禁止提交到仓库；
#   * 本文件中的所有值均为占位值，不含任何真实密钥；
#   * 程序自身不扫描 .env 文件，须由运维以环境变量方式注入（见 README 快速开始）。
# ---------------------------------------------------------------------------

# ---- 接口失败事件流（读）----
# ESB / 接口引擎的基地址，例：https://esb.hospital.example.internal
ESB_BASE_URL=https://esb.hospital.example.internal
# 访问令牌，对应请求头 authorization: bearer <ESB_TOKEN>
ESB_TOKEN=replace-with-esb-read-token

# ---- 对接凭据台账（读 + 写回）----
# 凭据台账服务基地址，例：https://credential.hospital.example.internal
CREDENTIAL_BASE_URL=https://credential.hospital.example.internal
# 访问令牌，对应请求头 authorization: bearer <CREDENTIAL_TOKEN>
CREDENTIAL_TOKEN=replace-with-credential-token

# ---- 归因模型端点（OpenAI-compatible）----
# 院内自建推理服务或云服务共用同一配置面，例：https://llm-gateway.hospital.example.internal
MODEL_BASE_URL=https://llm-gateway.hospital.example.internal
MODEL_API_KEY=replace-with-model-api-key
# 模型名
MODEL_NAME=replace-with-model-name
# 单次调用超时（毫秒）
MODEL_TIMEOUT_MS=20000
# 5xx / 429 时的最大重试次数
MODEL_MAX_RETRIES=2
# 单次归因最多带入的失败事件条数
MODEL_MAX_INPUT_EVENTS=200

# ---- 凭据指纹密钥 ----
# 用于计算凭据指纹的 HMAC-SHA256 密钥；必填、无默认值。
# 更换此值会使历史指纹失效，需要与运维约定后统一轮换。
FINGERPRINT_KEY=replace-with-hmac-key
